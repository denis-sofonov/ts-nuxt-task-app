{
  "name": "ts-nuxt-task-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "nuxt typecheck",
    "qa": "pnpm lint && pnpm format:check && pnpm typecheck",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx server/database/seed.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-vue-next": "^1.0.0",
    "nuxt": "^4.4.7",
    "postgres": "^3.4.9",
    "reka-ui": "^2.9.9",
    "shadcn-nuxt": "^2.7.4",
    "tailwind-merge": "^3.6.0",
    "vue": "^3.5.35"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.15.2",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^22.19.20",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "vue-tsc": "^3.3.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "unrs-resolver",
      "vue-demi"
    ]
  }
}
