# Application
NUXT_PUBLIC_APP_NAME=TaskFlow

# PostgreSQL connection string used by the Nitro server (Drizzle).
# Host port 5436 maps to the Postgres container in compose.yaml.
NUXT_DATABASE_URL=postgresql://taskflow:taskflow@localhost:5436/taskflow

# Separate database used by the test suite (created by the DB init script).
NUXT_TEST_DATABASE_URL=postgresql://taskflow:taskflow@localhost:5436/taskflow_test

# Session secret for nuxt-auth-utils (sealed httpOnly cookie).
# Must be at least 32 characters. Generate with: openssl rand -base64 32
NUXT_SESSION_PASSWORD=replace-with-a-32-char-minimum-secret
